# Zkopíruj jako .env.local a doplň. Soubor .env.local se necommituje.

# AppID přidělené správcem skautISu pro tuhle aplikaci.
SKAUTIS_APP_ID=

# Vypni demo režim, jakmile APP_ID funguje.
SKAUTIS_MOCK=0

# Testovací skautIS; pro ostrý provoz https://is.skaut.cz
SKAUTIS_BASE_URL=https://test-is.skaut.cz
