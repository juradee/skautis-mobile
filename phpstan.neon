parameters:
    level: 8
    paths:
        - src
        - tests
        - packages/skautis-symfony/src
        - packages/skautis-symfony/tests
    excludePaths:
        # Generated by the Symfony skeleton; not ours to shape.
        - src/Kernel.php
        - tests/bootstrap.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        -
            # This test boots its own kernel and makes the services public there;
            # the extension checks them against the application's container.
            identifier: symfonyContainer.privateService
            path: packages/skautis-symfony/tests/Functional/BundleIntegrationTest.php
